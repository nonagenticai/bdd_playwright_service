# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5461/bdd_playwright_service

# Redis
REDIS_URL=redis://localhost:6401/0

# Auth
AUTH_ENABLED=true

# API
API_PORT=6313

# Storage
STORAGE_LOCAL_PATH=/app/data
STORAGE_BACKEND=local

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Downstream services
# Peer service URLs are derived from w2v_common.discovery.service_url() using
# Kubernetes DNS (service.namespace). Override per-peer URLs
# with W2V_<NAME>_URL (e.g. W2V_TTS_URL=http://localhost:6194) for local dev,
# or set W2V_LOCAL=1 to default every peer to http://localhost:<port>.
DOWNSTREAM_LICENSE_TOKEN=

# Generation
GENERATION_MAX_SCENARIOS_PER_FEATURE=10
GENERATION_MAX_FEATURES_PER_JOB=20

# Narration
NARRATION_DEFAULT_TONE=tutorial
NARRATION_LLM_POLISH_ENABLED=true

# Logging
LOG_LEVEL=INFO
